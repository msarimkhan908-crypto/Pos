APP_NAME=POS
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8765

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

# ── Desktop: SQLite database (path set at runtime by Electron) ──────────────
DB_CONNECTION=sqlite
DB_DATABASE=

# ── Desktop: file-based drivers (no Redis/database server needed) ───────────
SESSION_DRIVER=file
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/

QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

# ── Desktop identity & sync ──────────────────────────────────────────────────
# Unique ID for this machine. Prefixes invoice numbers to avoid collisions
# with the web server. Example: DESK-001 → invoices become DESK-001-INV-000001
DEVICE_ID=DESK-001

# URL of your web POS server (leave blank to run fully offline)
SYNC_SERVER_URL=

# Secret token — must match SYNC_TOKEN on your web server .env
SYNC_TOKEN=

MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
